# Contact form (Resend) — required for /api/contact to send email.
# Without these the form returns a graceful 500 ("not configured yet").
#
# RESEND_API_KEY: create at https://resend.com (API Keys).
# CONTACT_EMAIL: where submissions are delivered. Until a sending domain is
#   verified in Resend, this MUST be the Resend account-owner email or sends fail.
RESEND_API_KEY=
CONTACT_EMAIL=chriszichkocoding@gmail.com

# Supabase variables are no longer used (static-first migration) and can be
# removed from any existing .env.local / Vercel project settings.
